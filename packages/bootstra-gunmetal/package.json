{
  "name": "bootstra-gunmetal",
  "version": "0.6.0",
  "description": "A Bootstrap 5 theme for Flash-era desktop interfaces: bevelled steel windows, floppy-disk icons, pixel type and one switchable glow colour.",
  "themeCollection": {
    "id": "bootstra-gunmetal",
    "name": "Gunmetal",
    "description": "Flash-era desktop interfaces: bevelled steel windows, floppy-disk icons, pixel type and one switchable glow colour.",
    "demo": "_site",
    "preview": "screenshots/screenshot.png"
  },
  "style": "dist/gunmetal.css",
  "main": "dist/gunmetal.css",
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "stylelint gunmetal.css && node --check gunmetal.js",
    "test": "npm run lint && npm run build"
  },
  "keywords": [
    "bootstrap",
    "bootstrap5",
    "theme",
    "css",
    "retro",
    "y2k",
    "flash",
    "desktop",
    "gunmetal"
  ],
  "author": "Artem Bloschinsky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloschinsky/bootstra-themes.git",
    "directory": "packages/bootstra-gunmetal"
  },
  "homepage": "https://bloschinsky.github.io/bootstra-themes/themes/bootstra-gunmetal/",
  "bugs": {
    "url": "https://github.com/bloschinsky/bootstra-themes/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.0"
  },
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0"
  }
}
